# SVG assets are hashed by content for cache-busting (`?v=<sha256[:10]>` in the
# public site HTML) and byte-compared between repo/assets and the site mirror.
# Pin them to LF on checkout so Windows (core.autocrlf=true on CI runners) sees
# the exact committed bytes and the hashes stay platform-independent.
*.svg text eol=lf

# This reviewed export is regenerated by `uv export` during every platform
# build. Keep its worktree bytes on LF too: Windows checkout otherwise writes
# CRLF, `uv` rewrites LF, and the later clean-tree bundle gate sees a false
# modification even though Git's normalized content is unchanged.
requirements-runtime.lock text eol=lf

# Golden scanner slices are SHA-pinned and must keep identical bytes on Windows.
tests/fixtures/skill_publish_scanner/*.fixture text eol=lf

# Generated engine schemas are SHA-pinned to the published contract bytes.
tests/fixtures/claudexor_image_contract/*.schema.json text eol=lf

# Recorded provider wire (SSE / JSON bodies) is byte-exact evidence: no line-ending
# conversion at commit or checkout, so the replay corpus always sees the recorded bytes.
tests/fixtures/llm_wire/** -text -whitespace

# Reference-book chapters are addressed by physical LF line ranges and byte
# spans (`reference_books` source refs, the generated inventories' chapter
# provenance notes, the migration byte proof). Pin every docs markdown file to
# LF so a Windows checkout reads the same lines and digests as the committed
# bytes.
docs/**/*.md text eol=lf

